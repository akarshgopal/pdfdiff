{
  "name": "@pdfdiff/core",
  "version": "0.1.0",
  "description": "Headless PDF and raster comparison algorithms.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../clean-dist.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "pixelmatch": "^7.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akarshgopal/pdfdiff.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/akarshgopal/pdfdiff",
  "bugs": {
    "url": "https://github.com/akarshgopal/pdfdiff/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
