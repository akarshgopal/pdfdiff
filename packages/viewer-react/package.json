{
  "name": "@pdfdiff/viewer-react",
  "version": "0.1.0",
  "description": "Reusable React viewer for PDF Diff comparisons.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "dist/theme.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/theme.css dist/theme.css"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@pdfdiff/core": "workspace:*",
    "tailwind-merge": "^3.6.0"
  }
}
