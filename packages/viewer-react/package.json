{
  "name": "@pdfdiff/viewer-react",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable React viewer for PDF Diff comparisons.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "dist/theme.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/styles.d.ts",
      "development": "./src/styles.ts",
      "import": "./dist/styles.js"
    },
    "./theme.css": {
      "development": "./src/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "scripts": {
    "build": "node ../clean-dist.mjs && tsc -p tsconfig.build.json && cp src/theme.css dist/theme.css"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@pdfdiff/core": "workspace:*",
    "tailwind-merge": "^3.6.0",
    "lucide-react": "^1.34.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akarshgopal/pdfdiff.git",
    "directory": "packages/viewer-react"
  },
  "homepage": "https://github.com/akarshgopal/pdfdiff",
  "bugs": {
    "url": "https://github.com/akarshgopal/pdfdiff/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
