{
  "name": "@pdfdiff/node",
  "version": "0.1.0",
  "description": "Headless PDF comparison for Node, plus the pdfdiff CLI.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pdfdiff": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../clean-dist.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@pdfdiff/core": "workspace:*",
    "@pdfdiff/pdfjs-text": "workspace:*",
    "pdfjs-dist": "^6.2.108"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akarshgopal/pdfdiff.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/akarshgopal/pdfdiff",
  "bugs": {
    "url": "https://github.com/akarshgopal/pdfdiff/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
