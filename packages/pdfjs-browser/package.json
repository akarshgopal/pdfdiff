{
  "name": "@pdfdiff/pdfjs-browser",
  "version": "0.1.0",
  "description": "Browser PDF.js adapter for PDF Diff.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "development": "./src/text.ts",
      "import": "./dist/text.js"
    },
    "./raster-diff-worker": {
      "types": "./dist/raster-diff-worker.d.ts",
      "development": "./src/raster-diff-worker.ts",
      "import": "./dist/raster-diff-worker.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@pdfdiff/core": "workspace:*",
    "pdfjs-dist": "^6.2.108"
  }
}
