{
  "name": "@pdfdiff/pdfjs-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser PDF.js adapter for PDF Diff.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./raster-diff-worker": {
      "types": "./dist/raster-diff-worker.d.ts",
      "development": "./src/raster-diff-worker.ts",
      "import": "./dist/raster-diff-worker.js"
    }
  },
  "scripts": {
    "build": "node ../clean-dist.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@pdfdiff/core": "workspace:*",
    "@pdfdiff/pdfjs-text": "workspace:*",
    "pdfjs-dist": "^6.2.108"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akarshgopal/pdfdiff.git",
    "directory": "packages/pdfjs-browser"
  },
  "homepage": "https://github.com/akarshgopal/pdfdiff",
  "bugs": {
    "url": "https://github.com/akarshgopal/pdfdiff/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
